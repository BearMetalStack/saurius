{
  // `upgrade` is disabled by default in Saurius (see the `upgrade` feature in
  // cli/Cargo.toml).
  "ignore": true,
  "tests": {
    "canary": {
      "args": "upgrade --canary asdfasdf",
      "output": "canary.out",
      "exitCode": 1
    },
    "version": {
      "args": "upgrade --version asdfasdf",
      "output": "version.out",
      "exitCode": 1
    },
    "shorthand": {
      "args": "upgrade asdfasdf",
      "output": "shorthand.out",
      "exitCode": 1
    }
  }
}
